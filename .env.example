# Copiez ce fichier en .env et remplissez-le.
# Clé secrète : générez-en une avec
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=0
# Adresse(s) du site, séparées par des virgules
DJANGO_ALLOWED_HOSTS=cadeaux.exemple.fr,51.20.125.129
DJANGO_CSRF_TRUSTED_ORIGINS=https://cadeaux.exemple.fr
# Mettez 0 tant que le site n'est pas en HTTPS (sinon la connexion échoue)
DJANGO_SECURE_COOKIES=1
DATABASE_PATH=/app/data/cadeaux.sqlite3
